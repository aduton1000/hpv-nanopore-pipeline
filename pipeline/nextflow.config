// Nextflow config — CPU-only; work/ and results/ in the USER's CWD, never /opt.
// Recommended runtime: Nextflow + Apptainer (reproducible, rootless containers) OR conda.

params.outdir = 'results'

// keep all scratch/work/cache in the user's space (HARD RULE: never write /opt)
workDir = "${System.getProperty('user.dir')}/work"
env {
    NXF_HOME            = "${System.getenv('HOME')}/.nextflow"
    APPTAINER_CACHEDIR  = "${System.getenv('HOME')}/.apptainer/cache"
}

process {
    executor = 'local'
    cpus = 4
    memory = '8 GB'
    errorStrategy = 'finish'
    withName: CONSENSUS { cpus = 8;  memory = '16 GB' }   // Clair3 is the heavy CPU step
    withName: TYPING    { cpus = 4 }
}

profiles {
    standard { }
    test     { params.samplesheet = null }   // uses the built-in tiny testdata/barcode01

    // Reproducible execution options (pick one at run time with -profile):
    conda    {
        conda.enabled = true
        // map each process to a shared env by label if desired; default uses activated env
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        // why Apptainer over Docker: rootless, HPC/shared-server friendly, no daemon,
        // images are single files cached in the user's $APPTAINER_CACHEDIR (not /opt).
    }
}

// resource + execution reports written under results/ (user space)
timeline { enabled = true; file = "${params.outdir}/_nf/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/_nf/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/_nf/trace.txt";     overwrite = true }
